# yadkin - Makefile for packaging Android
NAME = yadkin
BRANCH = linux
VERSION = @@VERSION@@
PREFIX = @@PREFIX@@
SRCURL = @@SRCURL@@
COMPANY = @@COMPANY@@ 
ORG = com.$(COMPANY).$(NAME)
CLITOOLS = commandlinetools-$(BRANCH)
TARGETS = "build-tools;31.0.0" "cmdline-tools;latest" "platform-tools" "ndk-bundle" "system-images;android-31;default;x86_64"
JDKBIN = @@JDKBIN@@
JDKVER = jdk-17.0.14+7


# main - Unpack dependencies and build the C utility
main: dependencies utility
	@printf "Build completed."


# dependencies - Android SDK, NDK and JDK dependencies
dependencies:
	test -d vendor/ || mkdir vendor/
	-rm -rf ./share/
	-mkdir -p ./share/sdk/cmdline-tools/latest
	test -f vendor/$(CLITOOLS).tar.gz || \
		wget -O "vendor/$(CLITOOLS).tar.gz" "$(SRCURL)/$(CLITOOLS).tar.gz"
	tar -xzf vendor/$(CLITOOLS).tar.gz -C ./share/sdk/cmdline-tools/
	test -f vendor/$(JDKBIN).tar.gz || \
		wget -O "vendor/$(JDKBIN).tar.gz" "$(SRCURL)/$(JDKBIN).tar.gz"
	tar -xzf vendor/$(JDKBIN).tar.gz -C ./share/
	export JAVA_HOME=./share/$(JDKVER) && \
	export ANDROID_SDK_ROOT=./share/sdk && \
		./share/sdk/cmdline-tools/latest/bin/sdkmanager --sdk_root=./share/sdk/cmdline-tools $(TARGETS)


# utility - The builder utility for default Android projects
utility:
	cd src/ && $(MAKE)


# install - Install
install:
	mkdir -p $(PREFIX)/bin/
	mkdir -p $(PREFIX)/etc/$(NAME)/
	mkdir -p $(PREFIX)/include/$(NAME)/
	mkdir -p $(PREFIX)/share/$(NAME)/images/
	# Create the Java/JVM dir
	mv ./share/$(JDKVER) $(PREFIX)/share/$(NAME)/
	ln -s $(PREFIX)/share/$(NAME)/$(JDKVER)/java $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/$(JDKVER)/keytool $(PREFIX)/bin/
	# Create the SDK home
	mv ./share/sdk/cmdline-tools $(PREFIX)/share/$(NAME)/sdk
	ln -s $(PREFIX)/share/$(NAME)/sdk/platform-tools/adb $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/emulator/emulator $(PREFIX)/bin/
	# Copy aliases and environment variables
	mv yadkin-init.sh $(PREFIX)/yadkin-init.sh
	@echo "$(NAME) was installed successfully, system for PATH changes to take effect."
	@echo "If you installed this to a non-standard location (like \$$HOME/.yadkin), be"
	@echo "sure to add the following line to your .bashrc or .bash_profile:"
	@echo
	@echo "test -f \"$(PREFIX)/yadkin-init.sh\" && source \"$(PREFIX)/yadkin-init.sh\""
	@echo

test-link:
	# Link the emulator and any other potentially needed tools 
	ln -s $(PREFIX)/share/$(NAME)/sdk/emulator/crashpad_handler $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/emulator/crashreport $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/emulator/emulator $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/emulator/emulator-check $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/emulator/mksdcard $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/emulator/netsimd $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/emulator/nimble_bridge $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/emulator/qemu-img $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/emulator/qsn $(PREFIX)/bin/
	# Link just Java and the keytool for now 
	ln -s $(PREFIX)/share/$(NAME)/$(JDKVER)/java $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/$(JDKVER)/keytool $(PREFIX)/bin/
	# Link all of the latest command line tools
	ln -s $(PREFIX)/share/$(NAME)/sdk/cmdline-tools/latest/bin/apkanalyzer $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/cmdline-tools/latest/bin/avdmanager $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/cmdline-tools/latest/bin/d8 $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/cmdline-tools/latest/bin/lint $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/cmdline-tools/latest/bin/profgen $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/cmdline-tools/latest/bin/r8 $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/cmdline-tools/latest/bin/resourceshrinker $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/cmdline-tools/latest/bin/retrace $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/cmdline-tools/latest/bin/screenshot2 $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/cmdline-tools/latest/bin/sdkmanager $(PREFIX)/bin/
	# Link the NDK build tools
	ln -s $(PREFIX)/share/$(NAME)/sdk/ndk-bundle/ndk-build $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/ndk-bundle/ndk-gdb $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/ndk-bundle/ndk-lldb $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/ndk-bundle/ndk-stack $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/ndk-bundle/ndk-which $(PREFIX)/bin/
	# Finally, link the platform-tools
	ln -s $(PREFIX)/share/$(NAME)/sdk/platform-tools/adb $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/platform-tools/etc1tool $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/platform-tools/fastboot $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/platform-tools/hprof-conv $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/platform-tools/make_f2fs $(PREFIX)/bin/
	ln -s $(PREFIX)/share/$(NAME)/sdk/platform-tools/make_f2fs_casefold $(PREFIX)/bin/
	# Leave this off on Linux
	#ln -s $(PREFIX)/share/$(NAME)/sdk/platform-tools/mke2fs $(PREFIX)/bin/
	# Leave SQLite off only because it's built into most platofrms...
	#ln -s $(PREFIX)/share/$(NAME)/sdk/platform-tools/sqlite3 $(PREFIX)/bin/

# TODO: This needs further testing and is only useful if the user is globally installing Yadkin
# configuration-install - Install config files globally
configuration-install:
	test -d /etc/zsh/ || mkdir -p /etc/zsh/
	cp environment/unix.env /etc/profile.d/$(NAME).sh
	test -d /etc/profile.d/ || mkdir -p /etc/profile.d/
	cp environment/unix.env /etc/zsh/$(NAME).zsh
	printf "$(NAME) installed successfully, please restart your terminal or system for PATH changes to take effect.\n"


# uninstall - Get rid of this software and it's changes
uninstall:
	-rm -rf $(PREFIX)/etc/$(NAME)/
	-rm -rf $(PREFIX)/include/$(NAME)/
	-rm -rf $(PREFIX)/share/$(NAME)/
	-rm -f $(PREFIX)/bin/$(NAME)
	#-rm -f $(PREFIX)/bin/java # Renaming yadkin's install of Java could be helpful
	#-rm -f $(PREFIX)/bin/keytool # Likewise this and the following two lines
	#-rm -f $(PREFIX)/bin/adb
	#-rm -f $(PREFIX)/bin/emulator
	-rm -f /etc/profile.d/$(NAME).sh
	-rm -f /etc/zsh/$(NAME).zsh
	echo "$(NAME) was uninstalled from your system.  Please either restart your terminal or reboot your system for PATH changes to take effect."


# explain - List all the targets and what they do
explain:
	@sed -n '/^#/p' Makefile | sed 's/# //' | \
		awk -F - '{ printf "%-12s %s\n", $$1, $$2 }'


# clean - Remove dependencies
clean:
	-rm -rf share/
	-rm -f yadkin-init.sh


# veryclean - Remove dependencies and generated Makefile
veryclean: clean
	rm -f Makefile


# docs - Create index.html
docs:
	markdown -S README.md > docs/index.html


.PHONY: build docs
